# Per-host niri settings.
# The shared config lives in ../configs/niri/config.kdl (symlinked for live editing),
# these options get rendered to ~/.config/niri-host/host.kdl, which config.kdl includes.
# Set them from system/hosts/<hostname>/default.nix via home-manager.users.simon.host.niri
{ config, lib, ... }:
let
  inherit (lib) mkOption types;
  cfg = config.host.niri;

  # toJSON gives KDL compatible quoted strings and numbers
  str = builtins.toJSON;
  indent = text: lib.concatMapStrings (line: "    ${line}\n") (lib.splitString "\n" text);

  renderOutput =
    name: o:
    let
      body = lib.concatStringsSep "\n" (
        lib.optional o.off "off"
        ++ lib.optional (o.mode != null) "mode ${str o.mode}"
        ++ lib.optional (o.scale != null) "scale ${str o.scale}"
        ++ lib.optional (o.transform != null) "transform ${str o.transform}"
        ++ lib.optional (o.position != null) "position x=${str o.position.x} y=${str o.position.y}"
        ++ lib.optional o.focusAtStartup "focus-at-startup"
        ++ lib.optional (o.extraConfig != "") (lib.removeSuffix "\n" o.extraConfig)
      );
    in
    "output ${str name} {\n${indent body}}\n";

  outputType = types.submodule {
    options = {
      off = mkOption {
        type = types.bool;
        default = false;
        description = "Disable this output.";
      };
      mode = mkOption {
        type = types.nullOr types.str;
        default = null;
        example = "1920x1080@60.000";
        description = "Mode as listed by `niri msg outputs`, null uses the preferred mode.";
      };
      scale = mkOption {
        type = types.nullOr types.number;
        default = null;
        example = 1.5;
      };
      transform = mkOption {
        type = types.nullOr (
          types.enum [
            "normal"
            "90"
            "180"
            "270"
            "flipped"
            "flipped-90"
            "flipped-180"
            "flipped-270"
          ]
        );
        default = null;
      };
      position = mkOption {
        type = types.nullOr (
          types.submodule {
            options = {
              x = mkOption { type = types.int; };
              y = mkOption { type = types.int; };
            };
          }
        );
        default = null;
        example = {
          x = 1920;
          y = 0;
        };
        description = "Position in logical pixels.";
      };
      focusAtStartup = mkOption {
        type = types.bool;
        default = false;
      };
      extraConfig = mkOption {
        type = types.lines;
        default = "";
        description = "Raw KDL appended inside the output block.";
      };
    };
  };
in
{
  options.host.niri = {
    autostart = mkOption {
      type = types.listOf types.str;
      default = [ ];
      example = [ "steam -silent" ];
      description = "Shell commands run at niri startup (spawn-sh-at-startup), in addition to the shared ones.";
    };

    outputs = mkOption {
      type = types.attrsOf outputType;
      default = { };
      description = "Output (monitor) configuration, keyed by connector or make/model/serial name.";
    };

    extraConfig = mkOption {
      type = types.lines;
      default = "";
      description = "Raw KDL appended to the host file.";
    };
  };

  config.xdg.configFile."niri-host/host.kdl".text = lib.concatStringsSep "\n" (
    [ "// Generated by home-manager from host.niri, edit system/hosts/<hostname>/default.nix instead.\n" ]
    ++ map (cmd: "spawn-sh-at-startup ${str cmd}\n") cfg.autostart
    ++ lib.mapAttrsToList renderOutput cfg.outputs
    ++ lib.optional (cfg.extraConfig != "") cfg.extraConfig
  );
}
