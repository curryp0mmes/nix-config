{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
	"logo": {
    "source": "${HOME}/.config/fastfetch/wuespace.png",
    "type": "kitty-direct",
    "width": 16,
    "height": 8,
    "padding": {
      "left": 1
    }
  },
  "modules": [
    "title",
    "separator",
    "uptime",
    "memory",
    "disk",
    "localip",
		{
			"type": "battery",
			"key": "Battery"
		},
    "poweradapter"
  ]
}
